# .secretsignore —— pre-commit 密钥扫描的额外规则
# ------------------------------------------------------------
#   pattern:<正则>   额外拦截
#   allow:<正则>     命中即放行（白名单 / 误报处理）
#   # 开头为注释
# ------------------------------------------------------------

# 文档里常见的占位符（避免误报）
allow:CHANGE_ME
allow:CHANGE_ME_TOKEN
allow:YOUR_TOKEN_HERE
allow:\$\{[A-Z_]+\}            # 形如 ${VAR} 的模板引用
allow:process\.env\.[A-Z_]+    # 代码里的环境变量读取

# 如果你有自定义前缀的密钥，在这里加：
# pattern:myco_[A-Za-z0-9]{32}
