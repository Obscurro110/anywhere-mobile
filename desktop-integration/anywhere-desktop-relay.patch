+    storeDeleteConversation({ dirPath, conversationId: ref, holderInstanceId, leaseEpoch })
+  )
+  rlog('[relay] deleted conversation', ref, 'removed =', res?.removed)
+  return { ok: res?.ok !== false, removed: !!res?.removed }
+}
