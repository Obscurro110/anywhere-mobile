+    const builtinIds = Object.entries(cfg.mcpServers || {})
+      .filter(([, s]) => s && s.type === 'builtin' && s.isActive !== false)
+      .map(([id]) => id)
+    cfg.tasks[taskId] = newTaskDefaults(String(name).trim(), builtinIds)
+  })
