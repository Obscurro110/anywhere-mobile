+  // 之前哪怕一条都没删掉也报「已删除 N 条」，手机端显示成功，
+  // 但重新打开会话消息又回来了 —— 用户以为「删了没反应」。
+  const removed = Number(res?.removed) || 0
+  const uiRemoved = Number(res?.uiRemoved) || 0
