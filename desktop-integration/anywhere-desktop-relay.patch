+/** 删除任务 */
+async function deletePhoneTask(taskId) {
+  const id = String(taskId || '').trim()
+  if (!id) return { ok: false, reason: 'taskId_required' }
+  let existed = false
+  await mutateConfig((cfg) => {
+    existed = !!cfg.tasks[id]
