+/**
+ * [anywhere-mobile] 手机互通版本号
+ * ------------------------------------------------------------
+ * 这个文件由 CI 根据仓库根的 version.json 自动重写（见
+ * .github/workflows/build-desktop-relay.yml 的 "注入版本号" 步骤）。
+ * 本地构建时如果没重写，就用这里的值。
+ */
+export const RELAY_VERSION = '1.2.0';
+export const RELAY_VERSION_CODE = 2;
diff --git a/main/windowManager.js b/main/windowManager.js
index 2096f34..eaed491 100644
--- a/main/windowManager.js
+++ b/main/windowManager.js
@@ -790,7 +790,20 @@ async function buildWindowInitMessage(payload = {}, senderId = '', fullConfig =
         ? payload.tempPromptConfig
         : null,
     senderId,
-    isAlwaysOnTop: payload?.isAlwaysOnTop ?? promptConfig?.isAlwaysOnTop ?? true
+    isAlwaysOnTop: payload?.isAlwaysOnTop ?? promptConfig?.isAlwaysOnTop ?? true,
+    // [anywhere-mobile] 手机互通用：这个函数是白名单复制，不在列表里的字段
