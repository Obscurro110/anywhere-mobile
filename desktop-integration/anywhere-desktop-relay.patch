+    })
+    if (live.busy && messages.at(-1)?.role !== 'assistant') {
+      messages.push({
+        index: live.messages.length,
+        pending: true,
+        id: 'live-pending',
+        storageId: '',
+        uiStorageId: '',
+        role: 'assistant',
+        text: '',
+        time: ''
