# ---- Anywhere Relay Server config ----
# Copy this file to ".env" and adjust values.
PORT=8787
HOST=0.0.0.0

# Shared secret. Each device authenticates with userId + token.
# Format: userId:token,userId2:token2   (comma separated)
# For a quick start, a single user + token is enough. Set your own!
AUTH_TOKENS=default-user:CHANGE_ME_TOKEN

# Where uploaded/relayed files are stored temporarily
FILE_DIR=./data/files
# File retention in hours (auto-purge)
FILE_TTL_HOURS=72
# Max single file size in MB
MAX_FILE_MB=512
